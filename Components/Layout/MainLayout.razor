@* 管理后台主框架：侧边导航 + 顶部信息栏 + 内容区 *@
@inherits LayoutComponentBase
@implements IDisposable
@inject UcsApiClient Api
@inject PermissionState Permissions
@inject NavigationManager Navigation
@inject UserManagementSystem.Configuration.AppConfiguration AppConfig
@inject SiteInfoState SiteInfo
@inject AuthenticationStateProvider AuthStateProvider

@* 仅当确认已登录后才渲染外壳。
   AuthorizeRouteView 会把「鉴权中 / 未授权」片段一并放进本布局渲染，
   若此处无条件输出，未登录用户会先看到整个控制台框架再被跳转到登录页（一闪而过）。
   Authorizing 输出空白：登录态恢复中，不需要框架。
   NotAuthorized 必须输出 @Body —— 该位置的内容是 RedirectToLogin，
   跳转由它自己的 OnInitialized 触发；若一并清空，跳转组件永远不会被实例化，
   未登录直接访问受保护页面会停在纯白页。 *@
<AuthorizeView>
    <Authorized>
        <div class="ucs-shell">
            <aside class="ucs-sider @(_collapsed ? "is-collapsed" : null)">
                <div class="ucs-sider-brand">
                    <span class="ucs-sider-logo"><UiIcon Name="terminal" Size="14" /></span>
                    @if (!_collapsed)
                    {
                        <span class="ucs-sider-title">@_siteName</span>
                    }
                </div>

                <div class="ucs-sider-menu">
                    <NavMenu Collapsed="_collapsed" />
                </div>

                <button class="ucs-sider-trigger" type="button" title="@(_collapsed ? "展开导航" : "收起导航")"
                        @onclick="ToggleCollapsed">
                    <UiIcon Name="@(_collapsed ? "panel-left-open" : "panel-left-close")" />
                </button>
            </aside>

            <div class="ucs-main">
                <header class="ucs-header">
                    <TopBar />
                </header>

                <main class="ucs-content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <Authorizing></Authorizing>
    <NotAuthorized>@Body</NotAuthorized>
</AuthorizeView>

<AntContainer />

@code {
    private bool _collapsed;

    /// <summary>侧栏标题：取自系统设置中的站点名称（获取失败时回落到 UCS）。</summary>
    private string _siteName = "UCS";

    /// <summary>权限版本轮询的取消源；circuit 销毁时取消，避免后台任务泄漏。</summary>
    private CancellationTokenSource? _pollCts;

    /// <summary>权限加载重入保护：轮询与首渲染可能同时触发。</summary>
    private bool _permissionLoadInFlight;

    /// <summary>
    /// 在 SSR（预渲染）阶段即获取站点名称，使首次渲染就显示真实名称，
    /// 避免"先显示默认 UCS、加载完成后再替换"的闪烁。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        SiteInfo.Changed += OnSiteInfoChanged;
        _siteName = SiteInfo.SiteName;
        await EnsureSiteInfoLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Api.SessionExpired += OnSessionExpired;

        // 会话恢复（受保护 sessionStorage）是异步的：必须等认证状态就绪后再拉取权限，
        // 否则首个权限请求可能不带令牌 → 401 → 清会话 → 跳登录（刷新后无法恢复）。
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await EnsurePermissionsLoadedAsync();
        }

        StartPermissionPolling();
    }

    /// <summary>
    /// 启动权限版本轮询：管理员改权限后，各实例的权限版本号立即变化，
    /// 前端在 <c>Permissions:ClientPollSeconds</c>（默认 30s）内发现并重新拉取，
    /// 从而让菜单与按钮自动显隐，无需用户刷新页面。
    /// </summary>
    private void StartPermissionPolling()
    {
        var seconds = AppConfig.Permissions.ClientPollSeconds;
        if (seconds <= 0 || _pollCts != null)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _ = PollPermissionVersionAsync(TimeSpan.FromSeconds(seconds), _pollCts.Token);
    }

    private async Task PollPermissionVersionAsync(TimeSpan interval, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(interval);

            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    // 首次加载可能因权限接口瞬时失败而落空：轮询必须继续重试，
                    // 不能因为 Permissions.Loaded=false 就永久跳过（否则只能刷新页面）。
                    if (!Permissions.Loaded)
                    {
                        await InvokeAsync(EnsurePermissionsLoadedAsync);
                        continue;
                    }

                    var latest = await Api.GetPermissionVersionAsync(ct);
                    if (!latest.Success || latest.Data is null)
                    {
                        // 会话失效：停止轮询，跳转由 SessionExpired 事件负责
                        if (latest.Code == ResultCodes.Unauthorized)
                        {
                            return;
                        }

                        continue;
                    }

                    if (latest.Data.Version == Permissions.Version)
                    {
                        continue;
                    }

                    var refreshed = await Api.GetEffectivePermissionsAsync(ct);
                    if (refreshed.Success && refreshed.Data is { } data)
                    {
                        await InvokeAsync(() => Permissions.Set(data.Codes, data.Level, data.Version));
                    }
                }
                catch (OperationCanceledException)
                {
                    return;
                }
                catch
                {
                    // 轮询是尽力而为：单次失败不打断用户操作，下一轮继续
                }
            }
        }
        catch (OperationCanceledException)
        {
            // 正常关闭
        }
    }

    private async Task EnsureSiteInfoLoadedAsync()
    {
        try
        {
            var result = await Api.GetAsync<SystemInfoResponse>("/api/system/info");
            if (result.Success && result.Data is { } info && !string.IsNullOrWhiteSpace(info.SiteName))
            {
                // 写入共享状态：系统设置页保存后也会调用 Set，布局订阅 Changed 即时刷新
                SiteInfo.Set(info.SiteName);
            }
        }
        catch
        {
            // 站点信息不可用时保留默认标题，不影响控制台使用
        }
    }

    private void OnSiteInfoChanged()
        => _ = InvokeAsync(() =>
        {
            _siteName = SiteInfo.SiteName;
            StateHasChanged();
        });

    private async Task EnsurePermissionsLoadedAsync()
    {
        if (Permissions.Loaded || _permissionLoadInFlight)
        {
            return;
        }

        _permissionLoadInFlight = true;
        try
        {
            var result = await Api.GetEffectivePermissionsAsync();
            if (result.Success && result.Data is { } data)
            {
                Permissions.Set(data.Codes, data.Level, data.Version);
            }
            else if (result.Code == ResultCodes.Unauthorized)
            {
                Permissions.Clear();
            }
        }
        finally
        {
            _permissionLoadInFlight = false;
        }
    }

    public void Dispose()
    {
        Api.SessionExpired -= OnSessionExpired;
        SiteInfo.Changed -= OnSiteInfoChanged;

        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    private void OnSessionExpired()
        => _ = InvokeAsync(() => Navigation.NavigateTo("/login?expired=1", replace: true));

    private void ToggleCollapsed() => _collapsed = !_collapsed;
}
