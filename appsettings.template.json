{
  // 通过系统（环境）变量配置数据库连接串：
  //   UCS_DB_CONNECTION=server=127.0.0.1;database=ucsdb;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD;CharSet=utf8mb4;MaximumPoolSize=100;MinimumPoolSize=5;ConnectionLifeTime=300;
  // 也可使用 ASP.NET Core 标准约定：ConnectionStrings__Default
  "Jwt": {
    // 不要在此填写真实密钥：通过环境变量 Jwt__Key 注入（至少 64 字符）。
    // 留空且 RequireExternalKey=false 时，应用会自动生成 keys/jwt-signing.key（仅适合本地开发）。
    "Key": "",
    "RequireExternalKey": false,
    "Issuer": "UserManagementAPI",
    "Audience": "UserManagementClient",
    "ExpiryMinutes": 120,
    // 登录会话（Refresh Token）有效期天数，登录响应中的 refresh_token_expires_in 由它换算
    "RefreshTokenDays": 30
  },
  // 权限缓存：缓存键带全局版本号前缀，写操作只增加版本号，因此跨实例变更生效延迟
  // 约等于 VersionCacheSeconds，CacheTtlMinutes 仅作兜底
  "Permissions": {
    "CacheTtlMinutes": 2,
    "VersionCacheSeconds": 1,
    // 控制台轮询权限版本号的间隔（秒），<=0 关闭前端自动刷新
    "ClientPollSeconds": 30
  },
  // 会话与登录安全
  "Security": {
    "SessionValidationCacheSeconds": 5,
    "LoginHistoryRetentionDays": 180,
    "LocationHistoryDays": 90,
    "AlertOnNewDevice": true,
    "AlertOnNewLocation": true,
    "AlertDedupHours": 24,
    // 离线 IP 库（ip2region.xdb）路径：相对路径基于内容根目录；
    // 文件缺失时归属地解析降级为「未知」，不会影响登录
    "Ip2RegionDbPath": "App_Data/ip2region.xdb"
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.yourdomain.com",
    // 控制台回环调用本进程 API 的基地址。【可选，一般留空】
    // 留空时自动使用进程真实监听地址（多地址优先 http；通配地址 0.0.0.0 / [::] / * / + 规范化为
    // localhost），因此无需任何环境变量或额外配置即可在本地与线上工作。
    // 仅当自动解析出的地址无法从本机访问时才需显式填写（此时务必填写本机可达的地址）。
    "SelfBaseUrl": "",
    "TokenExpiryMinutes": 20,
    "AdminPasswordLength": 12,
    "AllowedOrigins": "https://yourdomain.com",
    "DataProtectionKeysPath": "keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // 对外的 Host 白名单（分号分隔）。登记对外域名即可（如 "api.yourdomain.com"）；
  // 控制台回环调用所使用的本机地址会在启动后自动并入，无需在此手工添加。
  "AllowedHosts": "*"
}