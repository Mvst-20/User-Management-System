{
  "ConnectionStrings": {
    "Default": "server=localhost;database=ucsdb;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD;CharSet=utf8mb4;MaximumPoolSize=100;MinimumPoolSize=5;ConnectionLifeTime=300;"
  },
  "Jwt": {
    "Key": "YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_64_CHARACTERS_LONG_FOR_HMACSHA256",
    "Issuer": "UserManagementAPI",
    "Audience": "UserManagementClient",
    "ExpiryMinutes": 120
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "your-email@example.com",
    "Password": "YOUR_SMTP_PASSWORD",
    "From": "noreply@example.com",
    "FromName": "User Management System"
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.yourdomain.com",
    "TokenExpiryMinutes": 20,
    "AdminPasswordLength": 12,
    "AllowedOrigins": "https://yourdomain.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}