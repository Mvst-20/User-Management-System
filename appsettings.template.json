{
  // 通过系统（环境）变量配置数据库连接串：
  //   UCS_DB_CONNECTION=server=127.0.0.1;database=ucsdb;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD;CharSet=utf8mb4;MaximumPoolSize=100;MinimumPoolSize=5;ConnectionLifeTime=300;
  // 也可使用 ASP.NET Core 标准约定：ConnectionStrings__Default
  "Jwt": {
    "Key": "YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_64_CHARACTERS_LONG_FOR_HMACSHA256",
    "Issuer": "UserManagementAPI",
    "Audience": "UserManagementClient",
    "ExpiryMinutes": 120
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.yourdomain.com",
    // 控制台回环调用本进程 API 的基地址。
    // 控制台关闭了预渲染（见 Components/App.razor），渲染发生在 SignalR circuit 中，
    // 此时取不到 HttpContext，无法从请求推导地址；未配置时回落到 http://localhost:5000，
    // 该地址只在 dotnet run 的本地开发下有效。线上必须填写对外可访问的地址（通常与 ApiBaseUrl 相同）。
    "SelfBaseUrl": "https://api.yourdomain.com",
    "TokenExpiryMinutes": 20,
    "AdminPasswordLength": 12,
    "AllowedOrigins": "https://yourdomain.com",
    "DataProtectionKeysPath": "keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}